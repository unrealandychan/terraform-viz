  "terraform_version": "1.7.5",
  "planned_values": {
    "root_module": {
      "resources": [
        {
          "address": "aws_cloudfront_distribution.cdn",
          "mode": "managed", "type": "aws_cloudfront_distribution", "name": "cdn",
          "provider_name": "registry.terraform.io/hashicorp/aws",
          "schema_version": 1,
          "values": {
            "comment": "MVP CDN distribution",
            "enabled": true,
            "default_root_object": "index.html",
            "tags": { "env": "prod" }
          },
          "depends_on": ["aws_s3_bucket.static_site"]
        },
        {
          "address": "aws_s3_bucket.static_site",
          "mode": "managed", "type": "aws_s3_bucket", "name": "static_site",
          "provider_name": "registry.terraform.io/hashicorp/aws",
          "schema_version": 0,
          "values": {
            "bucket": "mvp-static-site-assets",
            "_usage_storage_gb": 5,
            "_usage_put_requests_k": 10,
            "_usage_get_requests_k": 100,
            "tags": { "purpose": "static-assets" }
          },
          "depends_on": []
        },
        {
          "address": "aws_s3_bucket_website_configuration.static_site",
          "mode": "managed", "type": "aws_s3_bucket_website_configuration", "name": "static_site",
