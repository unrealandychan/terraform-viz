            "display_name": "Dataflow Pipeline Lag Alert",
            "project": "bigdata-demo",
            "combiner": "OR",
            "conditions": [
              {
                "display_name": "Pub/Sub oldest message age",
                "condition_threshold": {
                  "filter": "resource.type=\"pubsub_subscription\" AND metric.type=\"pubsub.googleapis.com/subscription/oldest_unacked_message_age\"",
